{
    "swagger": "2.0",
    "info": {
        "title": "unoserver-web",
        "contact": {},
        "version": "0.1.0"
    },
    "basePath": "/",
    "paths": {
        "/convert/{format}": {
            "post": {
                "description": "Upload a file and convert it to the specified format",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/octet-stream"
                ],
                "tags": [
                    "conversion"
                ],
                "summary": "Convert file to specified format",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Target format (pdf, docx, odt, etc)",
                        "name": "format",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "File to convert",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Export filter options",
                        "name": "filter",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Converted file",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/github_com_lynxtaa_unoserver-web_internal_httperror.ErrorResponse"
                        }
                    },
                    "408": {
                        "description": "Conversion timeout",
                        "schema": {
                            "$ref": "#/definitions/github_com_lynxtaa_unoserver-web_internal_httperror.ErrorResponse"
                        }
                    },
                    "413": {
                        "description": "File too large",
                        "schema": {
                            "$ref": "#/definitions/github_com_lynxtaa_unoserver-web_internal_httperror.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/github_com_lynxtaa_unoserver-web_internal_httperror.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "github_com_lynxtaa_unoserver-web_internal_httperror.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "statusCode": {
                    "type": "integer"
                }
            }
        }
    }
}