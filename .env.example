# Application port
# PORT=3000

# Maximum number of parallel processes
# MAX_WORKERS=8

# Number of retries for converting input file
# CONVERSION_RETRIES=3

# Prefix path the app is served behind, used in Swagger and redirects
# BASE_PATH=

# Maximum uploaded file size in bytes (unlimited by default)
# MAX_FILE_SIZE=

# Minimum logged level: debug, info, warn or error
# LOG_LEVEL=info

# Log human-readable text instead of JSON
# PRETTY_LOGS=false

# The header name used to set the request-id
# REQUEST_ID_HEADER=

# The label used for the request identifier when logging the request
# REQUEST_ID_LOG_LABEL=reqId
